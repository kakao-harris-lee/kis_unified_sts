# CP-3 STOCK tenant MOCK session — environment TEMPLATE for run_tenant_session.sh (PR-3c).
#
# The stock tenant tree (config/tos_runtime/cp3-setup-d-stock-005930/) is the MOCK order tree
# (PR-3a, operator decision 2026-10-23): a fully verified attempt is sent to the KIS 모의투자
# order endpoint. This file names every TENANT_* value the runner requires for that session.
#
# ⚠ NO SECRETS, NO HOST PATHS. Every value below is either a non-secret identifier that IS
#   the session's definition (tree, direction, stock code, label, the repo's producer config)
#   or a ${VAR} reference the operator's host defines. Real keys never appear here or in the
#   runner's environment:
#     * the producer's REAL quotation keys (KIS_STOCK_APP_KEY / _SECRET) live in the env_file
#       its own config names — the runner REFUSES to start if either is exported (step 3b);
#     * the kis-mock order keys live in custody (kis_mock.app_key / kis_mock.app_secret under
#       TOS_STOCK_CUSTODY_ROOT, docs/runbooks/tos-kis-mock-transport.md §5);
#     * the stock MOCK account number lives in TOS_STOCK_ENV_MOCK (a file named `.env.mock`,
#       key KIS_STOCK_ACCOUNT_NO — RENDER.yaml `account.env_key`).
#
# Use (a fresh DETACHED checkout of origin/main — runner guard 1):
#   set -a; . tools/tos_cp3/runners/stock-mock-session.env.example; set +a
#   bash tools/tos_cp3/runners/run_tenant_session.sh
# with these defined first by the operator's host wrapper:
#   TOS_REPO                             the detached checkout this session runs from
#   TOS_PYTHON                           an interpreter whose tools.tos_cp3 is TOS_REPO's
#   TOS_STOCK_SESSION_ROOT               a fresh per-session directory (log, render, journals)
#   TOS_STOCK_DATA_PARENT                the tenant durable-set parent (never the resident set)
#   TOS_STOCK_ENV_MOCK                   path to the `.env.mock` carrying KIS_STOCK_ACCOUNT_NO
#   TOS_STOCK_CUSTODY_ROOT               custody root with the kis_mock.* scopes provisioned
#   TOS_STOCK_KIS_MOCK_TRANSPORT_CONFIG  the filled kis_mock_transport.yaml (price_scale 100)
#   TOS_STOCK_STOP_AT                    KST stop time, e.g. 15:35 (within one trading day)

TENANT_TREE=cp3-setup-d-stock-005930
TENANT_DIRECTION=LONG
TENANT_INSTRUMENT=005930
TENANT_ENVIRONMENT_LABEL=paper
TENANT_PRODUCER_CONFIG=${TOS_REPO}/config/tos_probes/cp3-live-producer-stock-005930.yaml

TENANT_PYTHON=${TOS_PYTHON}
TENANT_LOG=${TOS_STOCK_SESSION_ROOT}/session.log
TENANT_RENDER_OUT=${TOS_STOCK_SESSION_ROOT}/render
TENANT_JOURNAL=${TOS_STOCK_SESSION_ROOT}/journal.jsonl
TENANT_PRODUCER_SESSION_DIR=${TOS_STOCK_SESSION_ROOT}/producer
TENANT_DATA_PARENT=${TOS_STOCK_DATA_PARENT}
TENANT_ENV_FILE=${TOS_STOCK_ENV_MOCK}
TENANT_CUSTODY_ROOT=${TOS_STOCK_CUSTODY_ROOT}
TENANT_KIS_MOCK_TRANSPORT_CONFIG=${TOS_STOCK_KIS_MOCK_TRANSPORT_CONFIG}
TENANT_STOP_AT=${TOS_STOCK_STOP_AT}
