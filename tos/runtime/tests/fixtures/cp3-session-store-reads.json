        "as_of_ms": "INTEGER",
        "snapshot_json": "TEXT"
      },
      "preimages": {
        "snapshot_id": "TEXT",
        "raw_event_id": "TEXT"
      }
    }
  },
  "evidence": {
    "file_name": "evidence.sqlite3",
    "schema_version": 2,
    "reads": {
      "entries": {
        "seq": "INTEGER",
        "kind": "TEXT",
        "payload_json": "TEXT"
      }
    }
  },
  "inbox": {
