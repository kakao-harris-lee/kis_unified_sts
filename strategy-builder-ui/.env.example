# Strategy Builder UI는 기본적으로 same-origin /api/*를 호출하고,
# Next.js server route(app/api/[...path]/route.ts)가 KIS_BUILDER_API_BASE로
# proxy합니다. 남은 호출은 /api/tos/projection 하나입니다.
# NEXT_PUBLIC_API_URL을 설정하면 이 proxy를 우회하므로 일반적으로 비워둡니다.
# NEXT_PUBLIC_API_URL=

# Dashboard (Control Plane API) base.
KIS_BUILDER_API_BASE=http://localhost:5081

# Dashboard auth가 켜진 경우 서버사이드 proxy가 보낼 API key입니다.
# proxy는 이 키를 붙여 보내기 전에 호출자를 같은 키로 먼저 검증합니다.
# KIS_BUILDER_API_KEY=

# /tos 화면이 브라우저에서 직접 dashboard를 조회할 때 붙이는 key입니다
# (배포 스택에서는 Caddy가 /api/tos/*를 dashboard로 바로 보냅니다).
# 이 값은 클라이언트 자산에 그대로 들어가므로 신뢰된 배포에서만 설정하세요.
# NEXT_PUBLIC_API_KEY=
